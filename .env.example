# AddressIQ iOS SDK — local development overrides.
#
#   cp .env.example .env      # .env is gitignored; put real values there
#
# UNLIKE Flutter, Xcode does not read a .env file. This file is the documented
# source of truth for the variable names; feed them to your build one of two ways:
#
#   1. Xcode scheme (for running the app):
#      Product → Scheme → Edit Scheme → Run → Arguments → Environment Variables
#
#   2. Your shell (for `swift test`, or an xcodebuild run):
#      set -a; source .env; set +a
#      swift test
#
# Scheme variables belong to the scheme, not the binary, so they cannot leak into
# a released build. The SDK does not rely on that: an override supplied on any
# deployment other than `.development` is a fatal misconfiguration, not a value to
# be quietly ignored.

# ── Hosts ────────────────────────────────────────────────────────────────────
# Default is a hardcoded http://localhost:4000. The iOS SIMULATOR shares your
# Mac's network, so localhost works there. A PHYSICAL DEVICE does not — use your
# LAN IP (`ipconfig getifaddr en0`), and make sure your backend binds 0.0.0.0
# rather than 127.0.0.1.
ADDRESSIQ_DEV_API_URL=http://192.168.1.5:4000
ADDRESSIQ_DEV_INGEST_URL=http://192.168.1.5:4000

# Which CDN a dev build loads the SRI-pinned widget from. Defaults to the
# production CDN — the local backend serves no /v{x.y.z}/iqcollect.js, and the SDK
# ships no bundled copy. Set it only if you serve a published widget build yourself.
ADDRESSIQ_DEV_CDN_URL=

# ── Widget bundle ────────────────────────────────────────────────────────────
# Point the WebView at a widget you serve yourself, for live reload without
# re-vendoring:
#   cd ../addressiq-web && npx rollup -c && npx serve dist -p 5173
# (iOS reads this through `widgetURL` on the verify view rather than the
# environment; see the README.)
ADDRESSIQ_DEV_WIDGET_URL=
